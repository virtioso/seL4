/*
 * Copyright 2024, Technology Innovation Institute
 *
 * SPDX-License-Identifier: GPL-2.0-only
 *
 * Device tree for NVIDIA Orin AGX (Tegra234)
 * Minimal DTS for seL4 kernel boot
 */

/dts-v1/;

/* dt-bindings headers for symbolic constants (requires cpp preprocessing) */
#include <dt-bindings/clock/tegra234-clock.h>
#include <dt-bindings/gpio/tegra234-gpio.h>
#include <dt-bindings/interrupt-controller/arm-gic.h>
#include <dt-bindings/memory/tegra234-mc.h>
#include <dt-bindings/power/tegra234-powergate.h>
#include <dt-bindings/reset/tegra234-reset.h>

/ {
	model = "NVIDIA Orin AGX";
	compatible = "nvidia,p3701-0000", "nvidia,tegra234";
	interrupt-parent = <&gic>;
	#address-cells = <0x2>;
	#size-cells = <0x2>;

	chosen {
		stdout-path = "serial0:115200n8";
		/* MAC address for MGBE0 (nvidia,mac-addr-idx=0) */
		nvidia,ether-mac0 = "02:04:06:08:0a:0c";
	};

	aliases {
		serial0 = &tcu;
	};

	psci {
		compatible = "arm,psci-1.0", "arm,psci-0.2";
		method = "smc";
	};

	cpus {
		#address-cells = <0x1>;
		#size-cells = <0x0>;

		cpu@0 {
			compatible = "arm,cortex-a78";
			reg = <0x0>;
			device_type = "cpu";
			enable-method = "psci";
		};

		cpu@100 {
			compatible = "arm,cortex-a78";
			reg = <0x100>;
			device_type = "cpu";
			enable-method = "psci";
		};

		cpu@200 {
			compatible = "arm,cortex-a78";
			reg = <0x200>;
			device_type = "cpu";
			enable-method = "psci";
		};

		cpu@300 {
			compatible = "arm,cortex-a78";
			reg = <0x300>;
			device_type = "cpu";
			enable-method = "psci";
		};

		cpu@10000 {
			compatible = "arm,cortex-a78";
			reg = <0x10000>;
			device_type = "cpu";
			enable-method = "psci";
		};

		cpu@10100 {
			compatible = "arm,cortex-a78";
			reg = <0x10100>;
			device_type = "cpu";
			enable-method = "psci";
		};

		cpu@10200 {
			compatible = "arm,cortex-a78";
			reg = <0x10200>;
			device_type = "cpu";
			enable-method = "psci";
		};

		cpu@10300 {
			compatible = "arm,cortex-a78";
			reg = <0x10300>;
			device_type = "cpu";
			enable-method = "psci";
		};

		cpu@20000 {
			compatible = "arm,cortex-a78";
			reg = <0x20000>;
			device_type = "cpu";
			enable-method = "psci";
		};

		cpu@20100 {
			compatible = "arm,cortex-a78";
			reg = <0x20100>;
			device_type = "cpu";
			enable-method = "psci";
		};

		cpu@20200 {
			compatible = "arm,cortex-a78";
			reg = <0x20200>;
			device_type = "cpu";
			enable-method = "psci";
		};

		cpu@20300 {
			compatible = "arm,cortex-a78";
			reg = <0x20300>;
			device_type = "cpu";
			enable-method = "psci";
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x1 0xd 0x8>,  /* Secure Phys IRQ */
			     <0x1 0xe 0x8>,  /* Non-secure Phys IRQ */
			     <0x1 0xb 0x8>,  /* Virt IRQ */
			     <0x1 0xa 0x8>;  /* Hyp IRQ */
		always-on;
	};

	memory@80400000 {
		device_type = "memory";
		/* 4092MB RAM starting at 0x80400000 */
		reg = <0x0 0x80400000 0x0 0xFFC00000>;
	};

	/*
	 * TCU (Tegra Combined UART) - for seL4 kernel console.
	 * Has reg property pointing to HSP AON SM TX mailbox for UART_PPTR.
	 */
	tcu: serial {
		compatible = "nvidia,tegra234-tcu";
		reg = <0x0 0x0c168000 0x0 0x1000>;
		mboxes = <&hsp_aon 0 0x13000001>;
		mbox-names = "tx";
		status = "okay";
	};

	/*
	 * TCU for guest VM passthrough - no reg property.
	 * Linux TCU driver works purely via mboxes, no dedicated MMIO needed.
	 * This avoids overlap with HSP AON's device frame region.
	 */
	tcu_guest: serial-guest {
		compatible = "nvidia,tegra234-tcu", "nvidia,tegra194-tcu";
		mboxes = <&hsp_aon 0 0x13000001>;
		mbox-names = "tx";
		status = "okay";
	};

	/*
	 * bus@0 - simple-bus for memory-mapped peripherals
	 * Matches L4T DTB structure for consistent paths
	 */
	bus@0 {
		compatible = "simple-bus";
		#address-cells = <0x2>;
		#size-cells = <0x2>;
		ranges = <0x0 0x0 0x0 0x0 0x100 0x0>;  /* 1:1 mapping */

		gic: interrupt-controller@f400000 {
			compatible = "arm,gic-v3";
			reg = <0x0 0x0f400000 0x0 0x010000>,  /* GICD */
			      <0x0 0x0f440000 0x0 0x200000>;  /* GICR */
			#redistributor-regions = <1>;
			#interrupt-cells = <0x3>;
			interrupt-controller;
			interrupts = <0x1 0x9 0x4>;  /* GIC maintenance interrupt */
		};

		/*
		 * GPIO controller - Main GPIO
		 * Required for PHY reset on MGBE0 Ethernet
		 */
		gpio: gpio@2200000 {
			compatible = "nvidia,tegra234-gpio";
			reg-names = "security", "gpio";
			reg = <0x0 0x02200000 0x0 0x10000>,
			      <0x0 0x02210000 0x0 0x10000>;
			interrupts = <0x0 288 0x4>, <0x0 289 0x4>, <0x0 290 0x4>,
				     <0x0 291 0x4>, <0x0 292 0x4>, <0x0 293 0x4>,
				     <0x0 294 0x4>, <0x0 295 0x4>, <0x0 296 0x4>,
				     <0x0 297 0x4>, <0x0 298 0x4>, <0x0 299 0x4>,
				     <0x0 300 0x4>, <0x0 301 0x4>, <0x0 302 0x4>,
				     <0x0 303 0x4>, <0x0 304 0x4>, <0x0 305 0x4>,
				     <0x0 306 0x4>, <0x0 307 0x4>, <0x0 308 0x4>,
				     <0x0 309 0x4>, <0x0 310 0x4>, <0x0 311 0x4>,
				     <0x0 312 0x4>, <0x0 313 0x4>, <0x0 314 0x4>,
				     <0x0 315 0x4>, <0x0 316 0x4>, <0x0 317 0x4>,
				     <0x0 318 0x4>, <0x0 319 0x4>, <0x0 320 0x4>,
				     <0x0 321 0x4>, <0x0 322 0x4>, <0x0 323 0x4>,
				     <0x0 324 0x4>, <0x0 325 0x4>, <0x0 326 0x4>,
				     <0x0 327 0x4>, <0x0 328 0x4>, <0x0 329 0x4>,
				     <0x0 330 0x4>, <0x0 331 0x4>, <0x0 332 0x4>,
				     <0x0 333 0x4>, <0x0 334 0x4>, <0x0 335 0x4>;
			#interrupt-cells = <2>;
			interrupt-controller;
			#gpio-cells = <2>;
			gpio-controller;
		};

		/*
		 * APB MISC - Tegra APB miscellaneous registers
		 * Required for tegra_is_silicon() used by BPMP driver
		 */
		misc@100000 {
			compatible = "nvidia,tegra234-misc";
			reg = <0x0 0x00100000 0x0 0xf000>,    /* MISC base */
			      <0x0 0x0010f000 0x0 0x1000>;    /* STRAPPING_OPT_A */
			status = "okay";
		};

		/*
		 * UARTI - SBSA UART for VM console
		 * Physical address: 0x31d0000, Interrupt: SPI 146 (0x92)
		 */
		uarti: serial@31d0000 {
			compatible = "arm,sbsa-uart";
			reg = <0x0 0x031d0000 0x0 0x1000>;
			reg-io-width = <4>;           /* 32-bit MMIO access */
			interrupts = <0x0 0x92 0x4>;  /* SPI 146, level high */
			current-speed = <115200>;
			status = "okay";
		};

		/* HSP Top0 - Hardware Synchronization Primitives */
		hsp_top0: hsp@3c00000 {
			compatible = "nvidia,tegra234-hsp", "nvidia,tegra194-hsp";
			reg = <0x0 0x03c00000 0x0 0xa0000>;
			interrupts = <0x0 176 0x4>,   /* doorbell */
				     <0x0 120 0x4>,   /* shared0 */
				     <0x0 121 0x4>,   /* shared1 */
				     <0x0 122 0x4>,   /* shared2 */
				     <0x0 123 0x4>,   /* shared3 */
				     <0x0 124 0x4>,   /* shared4 */
				     <0x0 125 0x4>,   /* shared5 */
				     <0x0 126 0x4>,   /* shared6 */
				     <0x0 127 0x4>;   /* shared7 */
			interrupt-names = "doorbell", "shared0", "shared1", "shared2",
					  "shared3", "shared4", "shared5", "shared6",
					  "shared7";
			#mbox-cells = <2>;
			status = "okay";
		};

		/* HSP AON - for TCU communication */
		hsp_aon: hsp@c150000 {
			compatible = "nvidia,tegra234-hsp", "nvidia,tegra194-hsp";
			reg = <0x0 0x0c150000 0x0 0x90000>;
			interrupts = <0x0 133 0x4>,   /* shared1 */
				     <0x0 134 0x4>,   /* shared2 */
				     <0x0 135 0x4>,   /* shared3 */
				     <0x0 136 0x4>;   /* shared4 */
			interrupt-names = "shared1", "shared2", "shared3", "shared4";
			#mbox-cells = <2>;
			status = "okay";
		};

		/*
		 * SDMMC4 - Internal eMMC controller
		 * Physical address: 0x3460000, Interrupt: SPI 65
		 * Clocks/resets managed via BPMP
		 */
		mmc@3460000 {
			compatible = "nvidia,tegra234-sdhci", "nvidia,tegra186-sdhci";
			reg = <0x0 0x03460000 0x0 0x20000>;
			interrupts = <0x0 65 0x4>;    /* SPI 65, level high */
			clocks = <&bpmp 123>,         /* TEGRA234_CLK_SDMMC4 */
				 <&bpmp 219>;         /* TEGRA234_CLK_SDMMC_LEGACY_TM */
			clock-names = "sdhci", "tmclk";
			resets = <&bpmp 85>;          /* TEGRA234_RESET_SDMMC4 */
			reset-names = "sdhci";
			nvidia,pad-autocal-pull-up-offset-hs400 = <0x00>;
			nvidia,pad-autocal-pull-down-offset-hs400 = <0x00>;
			nvidia,pad-autocal-pull-up-offset-1v8-timeout = <0x0a>;
			nvidia,pad-autocal-pull-down-offset-1v8-timeout = <0x0a>;
			nvidia,pad-autocal-pull-up-offset-3v3-timeout = <0x0a>;
			nvidia,pad-autocal-pull-down-offset-3v3-timeout = <0x0a>;
			nvidia,default-tap = <0x8>;
			nvidia,default-trim = <0x14>;
			nvidia,dqs-trim = <40>;
			bus-width = <8>;
			non-removable;
			supports-cqe;
			status = "okay";
		};

		/*
		 * P2U PHY for MGBE0 - Tegra SerDes PHY
		 * Physical address: 0x3f20000, Interrupt: SPI 203
		 */
		p2u_gbe_0: phy@3f20000 {
			compatible = "nvidia,tegra234-p2u";
			reg = <0x0 0x03f20000 0x0 0x10000>;
			reg-names = "ctl";
			interrupts = <0x0 203 0x4>;   /* SPI 203, level high */
			interrupt-names = "intr";
			nvidia,bpmp = <&bpmp 16>;
			#phy-cells = <0>;
			status = "okay";
		};

		/*
		 * MGBE0 - Multi-Gigabit Ethernet controller
		 * Verbatim from Linux tegra234.dtsi + tegra234-p3737-0000+p3701-0000.dts
		 */
		ethernet@6800000 {
			compatible = "nvidia,tegra234-mgbe";
			reg = <0x0 0x06800000 0x0 0x10000>,
			      <0x0 0x06810000 0x0 0x10000>,
			      <0x0 0x068a0000 0x0 0x10000>;
			reg-names = "hypervisor", "mac", "xpcs";
			interrupts = <GIC_SPI 384 IRQ_TYPE_LEVEL_HIGH>;
			interrupt-names = "common";
			clocks = <&bpmp TEGRA234_CLK_MGBE0_APP>,
				 <&bpmp TEGRA234_CLK_MGBE0_MAC>,
				 <&bpmp TEGRA234_CLK_MGBE0_MAC_DIVIDER>,
				 <&bpmp TEGRA234_CLK_MGBE0_PTP_REF>,
				 <&bpmp TEGRA234_CLK_MGBE0_RX_INPUT_M>,
				 <&bpmp TEGRA234_CLK_MGBE0_RX_INPUT>,
				 <&bpmp TEGRA234_CLK_MGBE0_TX>,
				 <&bpmp TEGRA234_CLK_MGBE0_EEE_PCS>,
				 <&bpmp TEGRA234_CLK_MGBE0_RX_PCS_INPUT>,
				 <&bpmp TEGRA234_CLK_MGBE0_RX_PCS_M>,
				 <&bpmp TEGRA234_CLK_MGBE0_RX_PCS>,
				 <&bpmp TEGRA234_CLK_MGBE0_TX_PCS>;
			clock-names = "mgbe", "mac", "mac-divider", "ptp-ref", "rx-input-m",
				      "rx-input", "tx", "eee-pcs", "rx-pcs-input", "rx-pcs-m",
				      "rx-pcs", "tx-pcs";
			resets = <&bpmp TEGRA234_RESET_MGBE0_MAC>,
				 <&bpmp TEGRA234_RESET_MGBE0_PCS>;
			reset-names = "mac", "pcs";
			power-domains = <&bpmp TEGRA234_POWER_DOMAIN_MGBEB>;
			status = "okay";

			phy-handle = <&mgbe0_phy>;
			phy-mode = "10gbase-r";

			snps,axi-config = <&mgbe0_axi_setup>;

			mgbe0_axi_setup: stmmac-axi-config {
				snps,blen = <256 128 64 32>;
				snps,rd_osr_lmt = <63>;
				snps,wr_osr_lmt = <63>;
			};

			mdio {
				#address-cells = <1>;
				#size-cells = <0>;

				mgbe0_phy: phy@0 {
					compatible = "ethernet-phy-ieee802.3-c45";
					reg = <0x0>;
					#phy-cells = <0>;
				};
			};
		};
	};

	/* SRAM for BPMP shared memory */
	sram@40000000 {
		compatible = "nvidia,tegra234-sysram", "mmio-sram";
		reg = <0x0 0x40000000 0x0 0x80000>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x0 0x40000000 0x80000>;
		no-memory-wc;

		cpu_bpmp_tx: sram@70000 {
			reg = <0x70000 0x1000>;
			label = "cpu-bpmp-tx";
			pool;
		};

		cpu_bpmp_rx: sram@71000 {
			reg = <0x71000 0x1000>;
			label = "cpu-bpmp-rx";
			pool;
		};
	};

	/* BPMP - Boot and Power Management Processor */
	bpmp: bpmp {
		compatible = "nvidia,tegra234-bpmp", "nvidia,tegra186-bpmp";
		mboxes = <&hsp_top0 0x0 0x13>;  /* type=0 (doorbell), master=19 (BPMP) */
		shmem = <&cpu_bpmp_tx>, <&cpu_bpmp_rx>;
		#clock-cells = <1>;
		#reset-cells = <1>;
		#power-domain-cells = <1>;
		status = "okay";

		bpmp_i2c: i2c {
			compatible = "nvidia,tegra186-bpmp-i2c";
			nvidia,bpmp-bus-id = <5>;
			#address-cells = <1>;
			#size-cells = <0>;
		};
	};
};
