 *
 * Device tree for NVIDIA Orin AGX (Tegra234)
 * Minimal DTS for seL4 kernel boot
 */

/dts-v1/;

/ {
	model = "NVIDIA Orin AGX";
	compatible = "nvidia,p3701-0000", "nvidia,tegra234";
	interrupt-parent = <&gic>;
	#address-cells = <0x2>;
	#size-cells = <0x2>;

	chosen {
		stdout-path = "serial0:115200n8";
	};

	aliases {
		serial0 = &tcu;
	};

	psci {
		compatible = "arm,psci-1.0", "arm,psci-0.2";
		method = "smc";
	};

	cpus {
		#address-cells = <0x1>;
		#size-cells = <0x0>;

		cpu@0 {
			compatible = "arm,cortex-a78";
			reg = <0x0>;
			device_type = "cpu";
			enable-method = "psci";
		};

		cpu@100 {
			compatible = "arm,cortex-a78";
			reg = <0x100>;
			device_type = "cpu";
			enable-method = "psci";
		};

		cpu@200 {
			compatible = "arm,cortex-a78";
			reg = <0x200>;
			device_type = "cpu";
			enable-method = "psci";
		};

		cpu@300 {
			compatible = "arm,cortex-a78";
			reg = <0x300>;
			device_type = "cpu";
			enable-method = "psci";
		};

		cpu@10000 {
			compatible = "arm,cortex-a78";
			reg = <0x10000>;
			device_type = "cpu";
			enable-method = "psci";
		};

		cpu@10100 {
			compatible = "arm,cortex-a78";
			reg = <0x10100>;
			device_type = "cpu";
			enable-method = "psci";
		};

		cpu@10200 {
			compatible = "arm,cortex-a78";
			reg = <0x10200>;
			device_type = "cpu";
			enable-method = "psci";
		};

		cpu@10300 {
			compatible = "arm,cortex-a78";
			reg = <0x10300>;
			device_type = "cpu";
			enable-method = "psci";
		};

		cpu@20000 {
			compatible = "arm,cortex-a78";
			reg = <0x20000>;
			device_type = "cpu";
			enable-method = "psci";
		};

		cpu@20100 {
			compatible = "arm,cortex-a78";
			reg = <0x20100>;
			device_type = "cpu";
			enable-method = "psci";
		};

		cpu@20200 {
			compatible = "arm,cortex-a78";
			reg = <0x20200>;
			device_type = "cpu";
			enable-method = "psci";
		};

		cpu@20300 {
			compatible = "arm,cortex-a78";
			reg = <0x20300>;
			device_type = "cpu";
			enable-method = "psci";
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x1 0xd 0x8>,  /* Secure Phys IRQ */
			     <0x1 0xe 0x8>,  /* Non-secure Phys IRQ */
			     <0x1 0xb 0x8>,  /* Virt IRQ */
			     <0x1 0xa 0x8>;  /* Hyp IRQ */
		always-on;
	};

	gic: interrupt-controller@f400000 {
		compatible = "arm,gic-v3";
		reg = <0x0 0x0f400000 0x0 0x010000>,  /* GICD */
		      <0x0 0x0f440000 0x0 0x200000>;  /* GICR */
		#redistributor-regions = <1>;
		#interrupt-cells = <0x3>;
		interrupt-controller;
		interrupts = <0x1 0x9 0x4>;  /* GIC maintenance interrupt */
	};

	/*
	 * TCU (Tegra Combined UART) uses HSP shared mailbox.
	 * HSP AON base: 0x0c150000, SM TX(1) offset: 0x18000
	 * Result: 0x0c168000
	 */
	tcu: serial@c168000 {
		compatible = "nvidia,tegra234-tcu";
		reg = <0x0 0x0c168000 0x0 0x1000>;
		status = "okay";
	};

	memory@80000000 {
		device_type = "memory";
		/* 768MB RAM starting at 0x80000000 */
		reg = <0x0 0x80000000 0x0 0x30000000>;
	};

	/* HSP Top0 - Hardware Synchronization Primitives */
	hsp_top0: tegra-hsp@3c00000 {
		compatible = "nvidia,tegra234-hsp", "nvidia,tegra194-hsp";
		reg = <0x0 0x03c00000 0x0 0xa0000>;
		interrupts = <0x0 176 0x4>,   /* doorbell */
			     <0x0 120 0x4>,   /* shared0 */
			     <0x0 121 0x4>,   /* shared1 */
			     <0x0 122 0x4>,   /* shared2 */
			     <0x0 123 0x4>,   /* shared3 */
			     <0x0 124 0x4>,   /* shared4 */
			     <0x0 125 0x4>,   /* shared5 */
			     <0x0 126 0x4>,   /* shared6 */
			     <0x0 127 0x4>;   /* shared7 */
		interrupt-names = "doorbell", "shared0", "shared1", "shared2",
				  "shared3", "shared4", "shared5", "shared6",
				  "shared7";
		#mbox-cells = <2>;
		status = "okay";
	};

	/* HSP AON - for TCU communication */
	hsp_aon: tegra-hsp@c150000 {
		compatible = "nvidia,tegra234-hsp", "nvidia,tegra194-hsp";
		reg = <0x0 0x0c150000 0x0 0x90000>;
		interrupts = <0x0 133 0x4>,   /* shared1 */
			     <0x0 134 0x4>,   /* shared2 */
			     <0x0 135 0x4>,   /* shared3 */
			     <0x0 136 0x4>;   /* shared4 */
		interrupt-names = "shared1", "shared2", "shared3", "shared4";
		#mbox-cells = <2>;
		status = "okay";
	};

	/* SRAM for BPMP shared memory */
	sram@40000000 {
		compatible = "nvidia,tegra234-sysram", "mmio-sram";
		reg = <0x0 0x40000000 0x0 0x80000>;
		#address-cells = <1>;
		#size-cells = <1>;
		ranges = <0x0 0x0 0x40000000 0x80000>;
		no-memory-wc;

		cpu_bpmp_tx: sram@70000 {
			reg = <0x70000 0x1000>;
			label = "cpu-bpmp-tx";
			pool;
		};

		cpu_bpmp_rx: sram@71000 {
			reg = <0x71000 0x1000>;
			label = "cpu-bpmp-rx";
			pool;
		};
	};

	/* BPMP - Boot and Power Management Processor */
	bpmp: bpmp {
		compatible = "nvidia,tegra234-bpmp", "nvidia,tegra186-bpmp";
		mboxes = <&hsp_top0 0x2 0x13>;  /* DB type, BPMP master */
		shmem = <&cpu_bpmp_tx>, <&cpu_bpmp_rx>;
		#clock-cells = <1>;
		#reset-cells = <1>;
		#power-domain-cells = <1>;
		status = "okay";

		bpmp_i2c: i2c {
			compatible = "nvidia,tegra186-bpmp-i2c";
			nvidia,bpmp-bus-id = <5>;
			#address-cells = <1>;
			#size-cells = <0>;
		};
	};
};
