 *
 * Device tree for NVIDIA Orin AGX (Tegra234)
 * Minimal DTS for seL4 kernel boot
 */

/dts-v1/;

/ {
	model = "NVIDIA Orin AGX";
	compatible = "nvidia,p3701-0000", "nvidia,tegra234";
	interrupt-parent = <&gic>;
	#address-cells = <0x2>;
	#size-cells = <0x2>;

	chosen {
		stdout-path = "serial0:115200n8";
	};

	aliases {
		serial0 = &tcu;
	};

	psci {
		compatible = "arm,psci-1.0", "arm,psci-0.2";
		method = "smc";
	};

	cpus {
		#address-cells = <0x1>;
		#size-cells = <0x0>;

		cpu@0 {
			compatible = "arm,cortex-a78";
			reg = <0x0>;
			device_type = "cpu";
			enable-method = "psci";
		};

		cpu@100 {
			compatible = "arm,cortex-a78";
			reg = <0x100>;
			device_type = "cpu";
			enable-method = "psci";
		};

		cpu@200 {
			compatible = "arm,cortex-a78";
			reg = <0x200>;
			device_type = "cpu";
			enable-method = "psci";
		};

		cpu@300 {
			compatible = "arm,cortex-a78";
			reg = <0x300>;
			device_type = "cpu";
			enable-method = "psci";
		};

		cpu@10000 {
			compatible = "arm,cortex-a78";
			reg = <0x10000>;
			device_type = "cpu";
			enable-method = "psci";
		};

		cpu@10100 {
			compatible = "arm,cortex-a78";
			reg = <0x10100>;
			device_type = "cpu";
			enable-method = "psci";
		};

		cpu@10200 {
			compatible = "arm,cortex-a78";
			reg = <0x10200>;
			device_type = "cpu";
			enable-method = "psci";
		};

		cpu@10300 {
			compatible = "arm,cortex-a78";
			reg = <0x10300>;
			device_type = "cpu";
			enable-method = "psci";
		};

		cpu@20000 {
			compatible = "arm,cortex-a78";
			reg = <0x20000>;
			device_type = "cpu";
			enable-method = "psci";
		};

		cpu@20100 {
			compatible = "arm,cortex-a78";
			reg = <0x20100>;
			device_type = "cpu";
			enable-method = "psci";
		};

		cpu@20200 {
			compatible = "arm,cortex-a78";
			reg = <0x20200>;
			device_type = "cpu";
			enable-method = "psci";
		};

		cpu@20300 {
			compatible = "arm,cortex-a78";
			reg = <0x20300>;
			device_type = "cpu";
			enable-method = "psci";
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x1 0xd 0x8>,  /* Secure Phys IRQ */
			     <0x1 0xe 0x8>,  /* Non-secure Phys IRQ */
			     <0x1 0xb 0x8>,  /* Virt IRQ */
			     <0x1 0xa 0x8>;  /* Hyp IRQ */
		always-on;
	};

	gic: interrupt-controller@f400000 {
		compatible = "arm,gic-v3";
		reg = <0x0 0x0f400000 0x0 0x010000>,  /* GICD */
		      <0x0 0x0f440000 0x0 0x200000>;  /* GICR */
		#redistributor-regions = <1>;
		#interrupt-cells = <0x3>;
		interrupt-controller;
		interrupts = <0x1 0x9 0x4>;  /* GIC maintenance interrupt */
	};

	/*
	 * TCU (Tegra Combined UART) uses HSP shared mailbox.
	 * HSP AON base: 0x0c150000, SM TX(1) offset: 0x18000
	 * Result: 0x0c168000
	 */
	tcu: serial@c168000 {
		compatible = "nvidia,tegra234-tcu";
		reg = <0x0 0x0c168000 0x0 0x1000>;
		status = "okay";
	};

	memory@80032000 {
		device_type = "memory";
		/* 768MB RAM starting at 0x80032000 - avoids first 200KB of DRAM where RAS errors occur */
		reg = <0x0 0x80032000 0x0 0x30000000>;
	};
};
